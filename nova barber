<style>

/* =========================
   GENERAL
========================= */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Arial, Helvetica, sans-serif;
    background:#0a0a0a;
    color:#fff;
    line-height:1.6;
}

a{
    text-decoration:none;
    color:inherit;
}

.container{
    width:90%;
    max-width:1150px;
    margin:auto;
}

section{
    padding:90px 0;
}


/* =========================
   HEADER
========================= */

header{
    position:sticky;
    top:0;
    z-index:1000;

    background:rgba(10,10,10,.94);

    backdrop-filter:blur(12px);

    border-bottom:1px solid #292929;
}

.navbar{
    min-height:72px;

    display:flex;

    align-items:center;

    justify-content:space-between;
}

.logo{
    font-size:25px;

    font-weight:900;

    letter-spacing:2px;
}

.logo span{
    color:#d4a84f;
}

nav{
    display:flex;

    gap:25px;
}

nav a{
    color:#aaa;

    font-size:14px;

    transition:.2s;
}

nav a:hover{
    color:#fff;
}

.btn{
    display:inline-block;

    padding:14px 22px;

    border-radius:6px;

    font-weight:bold;

    transition:.25s;
}

.btn-gold{
    background:#d4a84f;

    color:#0a0a0a;
}

.btn-gold:hover{
    transform:translateY(-3px);

    box-shadow:
    0 10px 30px
    rgba(212,168,79,.22);
}

.btn-dark{
    background:#151515;

    border:1px solid #3a3a3a;
}

.btn-dark:hover{
    background:#202020;
}


/* =========================
   HERO
========================= */

.hero{
    min-height:720px;

    display:flex;

    align-items:center;

    background:

    radial-gradient(
        circle at 75% 35%,
        rgba(212,168,79,.18),
        transparent 40%
    ),

    linear-gradient(
        135deg,
        #0a0a0a,
        #15130e
    );
}

.hero-content{
    max-width:750px;
}

.tag{
    color:#d4a84f;

    font-size:13px;

    font-weight:bold;

    letter-spacing:3px;
}

.hero h1{
    font-family:Georgia, serif;

    font-size:76px;

    line-height:1;

    letter-spacing:-3px;

    margin:20px 0;
}

.hero h1 span{
    color:#d4a84f;
}

.hero p{
    max-width:650px;

    color:#999;

    font-size:19px;

    margin-bottom:30px;
}

.buttons{
    display:flex;

    gap:12px;

    flex-wrap:wrap;
}

.note{
    margin-top:25px;

    color:#666;

    font-size:13px;
}


/* =========================
   STATS
========================= */

.stats{
    background:#111;

    border-top:1px solid #282828;

    border-bottom:1px solid #282828;
}

.stats-grid{
    display:grid;

    grid-template-columns:
    repeat(4,1fr);

    padding:35px 0;
}

.stat{
    text-align:center;

    border-right:1px solid #292929;
}

.stat:last-child{
    border:none;
}

.stat strong{
    display:block;

    color:#d4a84f;

    font-size:28px;
}

.stat span{
    color:#777;

    font-size:14px;
}


/* =========================
   TITULOS
========================= */

.heading{
    max-width:700px;

    margin:0 auto 50px;

    text-align:center;
}

.heading h2{
    font-family:Georgia, serif;

    font-size:43px;

    line-height:1.1;

    margin:10px 0 15px;
}

.heading p{
    color:#888;
}


/* =========================
   SERVICIOS
========================= */

.services{
    background:#0a0a0a;
}

.cards{
    display:grid;

    grid-template-columns:
    repeat(3,1fr);

    gap:20px;
}

.card{
    background:#111;

    border:1px solid #292929;

    border-radius:10px;

    padding:30px;

    transition:.25s;
}

.card:hover{
    transform:translateY(-6px);

    border-color:#d4a84f;
}

.icon{
    font-size:40px;

    margin-bottom:18px;
}

.card h3{
    margin-bottom:10px;
}

.card p{
    color:#888;

    font-size:14px;
}


/* =========================
   SERVICIOS DESTACADOS
========================= */

.featured{
    background:#111;
}

.feature-grid{
    display:grid;

    grid-template-columns:
    repeat(3,1fr);

    gap:20px;
}

.feature{
    padding:30px;

    background:#151515;

    border:1px solid #292929;

    border-radius:10px;
}

.feature h3{
    color:#d4a84f;

    margin-bottom:10px;
}

.feature p{
    color:#888;
}


/* =========================
   PRECIOS
========================= */

.pricing{
    background:#0a0a0a;
}

.price-grid{
    display:grid;

    grid-template-columns:
    repeat(3,1fr);

    gap:20px;
}

.price-card{
    background:#111;

    border:1px solid #292929;

    border-radius:10px;

    padding:32px;
}

.price-card.featured-card{
    border:2px solid #d4a84f;

    transform:scale(1.02);
}

.price-card h3{
    font-size:22px;
}

.price{
    font-size:38px;

    font-weight:bold;

    margin:20px 0;
}

.price small{
    color:#777;

    font-size:14px;

    font-weight:normal;
}

.price-card ul{
    list-style:none;

    color:#999;

    margin-bottom:25px;
}

.price-card li{
    margin:10px 0;
}


/* =========================
   HORARIOS
========================= */

.schedule{
    background:#111;
}

.schedule-box{
    max-width:850px;

    margin:auto;

    border:1px solid #292929;

    border-radius:10px;

    overflow:hidden;
}

.schedule-row{
    display:grid;

    grid-template-columns:
    1fr 1fr;

    padding:20px;

    background:#151515;

    border-bottom:1px solid #292929;
}

.schedule-row:last-child{
    border:none;
}

.schedule-row span:last-child{
    text-align:right;

    color:#d4a84f;
}


/* =========================
   CONTACTO
========================= */

.contact{
    background:

    radial-gradient(
        circle at center,
        rgba(212,168,79,.14),
        transparent 55%
    );
}

.contact-box{
    max-width:750px;

    margin:auto;

    padding:50px 30px;

    text-align:center;

    border:1px solid #292929;

    border-radius:12px;

    background:#111;
}

.contact-box h2{
    font-family:Georgia, serif;

    font-size:42px;

    margin:10px 0 15px;
}

.contact-box p{
    color:#888;

    margin-bottom:30px;
}

.contact-buttons{
    display:flex;

    justify-content:center;

    gap:12px;

    flex-wrap:wrap;
}


/* =========================
   CTA
========================= */

.cta{
    background:#d4a84f;

    color:#0a0a0a;

    text-align:center;
}

.cta h2{
    font-family:Georgia, serif;

    font-size:44px;

    margin-bottom:15px;
}

.cta p{
    margin-bottom:25px;
}

.cta .btn{
    background:#0a0a0a;

    color:#fff;
}


/* =========================
   FOOTER
========================= */

footer{
    background:#050505;

    text-align:center;

    color:#666;

    padding:40px 0;
}

.footer-logo{
    color:#fff;

    font-weight:bold;

    font-size:20px;

    margin-bottom:10px;
}

.footer-logo span{
    color:#d4a84f;
}

.nexora{
    display:inline-block;

    margin-top:12px;

    color:#d4a84f;

    font-weight:bold;
}


/* =========================
   RESPONSIVE
========================= */

@media(max-width:850px){

    nav{
        display:none;
    }

    .hero{
        text-align:center;
    }

    .hero-content{
        margin:auto;
    }

    .hero h1{
        font-size:54px;

        letter-spacing:-2px;
    }

    .buttons{
        justify-content:center;
    }

    .stats-grid{
        grid-template-columns:
        1fr 1fr;

        gap:25px;
    }

    .stat{
        border:none;
    }

    .cards,
    .feature-grid,
    .price-grid{
        grid-template-columns:1fr;
    }

    .price-card.featured-card{
        transform:none;
    }

}

@media(max-width:550px){

    section{
        padding:70px 0;
    }

    .hero{
        min-height:650px;
    }

    .hero h1{
        font-size:43px;
    }

    .hero p{
        font-size:16px;
    }

    .heading h2{
        font-size:35px;
    }

    .stats-grid{
        grid-template-columns:1fr;
    }

    .contact-box h2{
        font-size:32px;
    }

}

</style>

</head>


